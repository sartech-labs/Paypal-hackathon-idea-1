# Application Environment (development | test | production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Publicly reachable base URL used by PayPal's browser return/cancel callbacks
APP_PUBLIC_URL=http://127.0.0.1:8000
# demo: "/" is the owner console. gateway: "/" proxies the owner website and the console
# stays at /console. Set SARA_MODE=gateway when deploying in front of a real site.
SARA_MODE=demo

# Payment Provider Mode (mock | paypal_sandbox)
PAYMENT_MODE=mock

# PayPal Sandbox Configuration (Required when PAYMENT_MODE=paypal_sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=15.0
# Sandbox only: pay deposits with PayPal's Sandbox test card instead of a buyer login,
# so the live demo completes real Sandbox payments without anyone signing in.
PAYPAL_SANDBOX_AUTOPAY=false
# Webhook ID from the PayPal app (Developer Dashboard > Apps > your app > Webhooks), pointing at
# {APP_PUBLIC_URL}/webhooks/paypal. Events are verified against it; leave empty to reject Sandbox webhooks.
PAYPAL_WEBHOOK_ID=

# PayPal assistant (read-only) through PayPal's MCP server. Uses PAYPAL_CLIENT_ID/SECRET.
# local: runs @paypal/mcp with Node.js 18+ (the Docker image includes it).
# hosted: PayPal's remote server; as of Nov 2026 it lists tools but its tool calls failed.
PAYPAL_MCP_ENABLED=true
PAYPAL_MCP_TRANSPORT=local
# PAYPAL_MCP_COMMAND=npx -y @paypal/mcp@1.8.1
# PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# Deposit and Session Policy Defaults (Can also be configured in data/site_config.json)
# Tiered content pricing (deposit per pricing tier, in PAYPAL_CURRENCY).
# Tier1 = Premium (market intelligence, research, financial reports)
# Tier2 = Standard (industry analysis, market research, company information)
# Tier3 = Public (general news, announcements, basic information)
# Leave a value empty to keep the price from data/site_config.json.
TIER1_PRICE=20.00
TIER2_PRICE=10.00
TIER3_PRICE=5.00
# Base deposit for paths outside every pricing tier (on the bundled demo site, the
# site root /). The /news sections are Public-tier content, so the rogue-crawler
# scenario pays TIER3_PRICE. The owner console can change this live.
DEPOSIT_AMOUNT=1.00
# Deposit settlement: refund (capture, then refund compliant sessions) or
# authorization (hold, then void for compliant sessions; capture only on forfeiture)
# Production: authorization (an honest agent's hold is voided, so it carries no PayPal fee).
DEPOSIT_SETTLEMENT=refund
# Target website. Set it here for the first boot, or live from the owner console.
# In gateway mode SARA proxies human and allowed agent traffic to this URL.
ORIGIN_URL=
# Timeout for requests forwarded to the target website.
ORIGIN_TIMEOUT_SECONDS=10
# Owner-console changes (target URL, tier deposits, rules) persist in this JSON file.
# Mount storage/ on a volume so the file survives container replacement and redeploys.
GATEWAY_CONFIG_PATH=storage/gateway_config.json
# Demo mode only (ignored when SARA_MODE=gateway): let visitors apply configuration
# without the admin token. Deposit, tier, rule and limit edits are allowed; changing the
# target URL without a token additionally needs the host in DEMO_ORIGIN_ALLOWLIST.
DEMO_CONFIG_PUBLIC=true
# Comma-separated hosts public (tokenless) visitors may point the gateway at. Empty means
# the target URL can only be changed with the admin token. Admin-token writes are
# unrestricted, so production gateways should leave DEMO_CONFIG_PUBLIC=false.
DEMO_ORIGIN_ALLOWLIST=
# Hourly quota for public (non-admin) configuration writes.
CONFIG_MAX_WRITES_PER_HOUR=30
# Transparent edge: classify unsigned clients by User-Agent (a signature always counts).
# Fails closed: a recognised real-browser User-Agent is let through as a human, everything else
# - crawlers, scripts, HTTP libraries, missing or unknown User-Agents - is treated as an agent
# and must post the deposit. Set false to classify by signature only.
DETECT_AGENT_USER_AGENTS=true
# Curated good/bad action playground at the owner console. Starting a run also needs
# the admin token, or DEMO_PUBLIC=true.
PLAYGROUND_MAX_RUNS_PER_HOUR=20
# Verified agents (signed requests, Web Bot Auth): known keys, and how a record moves the deposit.
AGENT_DIRECTORY_PATH=data/agent_directory.json
REQUIRE_SIGNED_AGENTS=false
TRUSTED_AGENT_DISCOUNT=0.50
FLAGGED_AGENT_MULTIPLIER=3
REFUSE_AFTER_FORFEITS=3
SESSION_TTL_SECONDS=1800
CHALLENGE_TTL_SECONDS=600

# Rate Limiting and Request Budget
MAX_REQUESTS_PER_SESSION=10
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=10

# Persistence and Data Paths
SITE_CONFIG_PATH=data/site_config.json
ROBOTS_CONFIG_PATH=data/robots.json
ALLOWED_PAGES_PATH=data/allowed_pages.json
DISALLOWED_PAGES_PATH=data/disallowed_pages.json
AUDIT_LOG_PATH=storage/audit.jsonl
PAYMENTS_DB_PATH=storage/payments_db.json
SESSIONS_DB_PATH=storage/sessions_db.json
# Agent commerce: offer catalog (pay-per-access, subscriptions, products) and its store
COMMERCE_CATALOG_PATH=data/commerce_catalog.json
COMMERCE_DB_PATH=storage/commerce_db.json

# Administrative Authorization
# Leave empty in development to use the local-only demo header value documented in README,
# or set a high-entropy secret token for protected /audit/* and admin operations.
ADMIN_API_TOKEN=

# Publisher console at /console (read-only without the admin token when true).
# Convenient for local demos and judge deployments; keep false in production.
DASHBOARD_PUBLIC=true

# Agent studio at /agent: when true, anyone may start crawler runs and ask the PayPal
# assistant, within these hourly caps. Otherwise those need the admin token.
DEMO_PUBLIC=true
DEMO_MAX_RUNS_PER_HOUR=20
DEMO_MAX_QUESTIONS_PER_HOUR=30

# Operational Logging
LOG_LEVEL=INFO

# AI features: deposit explanations, policy assistant, AI crawler agent.
# Uncomment one key to enable them; without a key the gateway uses rule-based
# explanations and the policy assistant returns HTTP 503.
# AI_PROVIDER: auto (Claude if an Anthropic key is set, otherwise OpenAI), openai, or anthropic.
# AI_MODEL: leave unset for the provider default (gpt-5.5 on OpenAI, claude-opus-5-5 on Claude).
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
AI_PROVIDER=auto
# AI_MODEL=
AI_ENABLED=true
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT_SECONDS=120
