# Application Environment (development | test | production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Publicly reachable base URL used by PayPal's browser return/cancel callbacks
APP_PUBLIC_URL=http://127.0.0.1:8000

# Payment Provider Mode (mock | paypal_sandbox)
PAYMENT_MODE=mock

# PayPal Sandbox Configuration (Required when PAYMENT_MODE=paypal_sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=15.0

# Deposit and Session Policy Defaults (Can also be configured in data/site_config.json)
DEPOSIT_AMOUNT=0.01
# Deposit settlement: refund (capture, then refund compliant sessions) or
# authorization (hold, then void for compliant sessions; capture only on forfeiture)
DEPOSIT_SETTLEMENT=refund
SESSION_TTL_SECONDS=1800
CHALLENGE_TTL_SECONDS=600

# Rate Limiting and Request Budget
MAX_REQUESTS_PER_SESSION=10
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=10

# Persistence and Data Paths
SITE_CONFIG_PATH=data/site_config.json
ROBOTS_CONFIG_PATH=data/robots.json
ALLOWED_PAGES_PATH=data/allowed_pages.json
DISALLOWED_PAGES_PATH=data/disallowed_pages.json
AUDIT_LOG_PATH=storage/audit.jsonl
PAYMENTS_DB_PATH=storage/payments_db.json
SESSIONS_DB_PATH=storage/sessions_db.json

# Administrative Authorization
# Leave empty in development to use the local-only demo header value documented in README,
# or set a high-entropy secret token for protected /audit/* and admin operations.
ADMIN_API_TOKEN=

# Publisher dashboard at / (read-only without the admin token when true).
# Convenient for local demos and judge deployments; keep false in production.
DASHBOARD_PUBLIC=true

# Operational Logging
LOG_LEVEL=INFO

# AI features: deposit explanations, policy assistant, AI crawler agent.
# Uncomment one key to enable them; without a key the gateway uses rule-based
# explanations and the policy assistant returns HTTP 503.
# AI_PROVIDER: auto (Claude if an Anthropic key is set, otherwise OpenAI), openai, or anthropic.
# AI_MODEL: leave unset for the provider default (gpt-5.5 on OpenAI, claude-opus-5-5 on Claude).
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
AI_PROVIDER=auto
# AI_MODEL=
AI_ENABLED=true
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT_SECONDS=120
